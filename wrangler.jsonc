{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ccf-2-spa",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ccf-spa",
      "database_id": "88268cdc-c542-4edc-8156-295cacbdfe1f",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // PAYMENT track. Only NON-SECRET config lives here as plain vars. The real
  // secrets (SEPAY_API_KEY, SEPAY_ACCOUNT_NUMBER, PAYPAL_CLIENT_ID,
  // PAYPAL_SECRET, PAYPAL_WEBHOOK_ID) MUST be set with `wrangler secret put
  // <NAME>` — never committed here. See the "Payment secrets" note in README.
  //
  // T-19 AUTH secrets (also `wrangler secret put`, never committed):
  //   ADMIN_PASSWORD  — the shared admin login password.
  //   SESSION_SECRET  — HMAC key that signs the admin session cookie.
  // Local dev reads them from .dev.vars (gitignored). See docs/DEPLOY.md.
  "vars": {
    // PayPal sandbox base by default; set to https://api-m.paypal.com in prod.
    "PAYPAL_BASE_URL": "https://api-m.sandbox.paypal.com",
    // VND per 1 USD used to convert at PayPal order-creation time. Configurable.
    "PAYPAL_VND_PER_USD": "25000"
  }
}
